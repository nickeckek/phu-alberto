---
import Layout from '../layouts/Layout.astro';
---

<Layout title="PHU ALBERTO Łaziska - Węgiel | Złom | Kruszywa">
    <div class="fixed inset-0 -z-20 bg-[#F5F5F7]">
        <div class="absolute inset-0 bg-gradient-to-tr from-[#FF8C00]/5 via-white/50 to-white/80 opacity-40 blur-3xl"></div>
    </div>

    <main class="max-w-[1400px] mx-auto px-6 overflow-hidden">
        
        <header class="py-24 lg:py-48 grid lg:grid-cols-[1fr,minmax(auto,650px)] gap-16 lg:gap-32 items-center">
            
            <div class="space-y-12 reveal-text">
                

                <h1 class="text-8xl md:text-[150px] font-heavy leading-[0.7] tracking-[-0.08em] text-black italic uppercase relative">
                    JAKOŚĆ<br/>
                    <span class="text-[#FF8C00]">BEZ</span>
                    <span class="relative text-[#FF8C00]">
                        KOMPROMISU
                        <div class="absolute -bottom-4 left-0 w-48 h-1 bg-black/10 rounded-full"></div>
                    </span>
                    <span class="text-gray-200 absolute -top-12 -left-16 text-[250px] -z-10 font-black opacity-10">#1</span>
                </h1>

                <p class="text-2xl md:text-3xl font-bold text-gray-400 leading-[1.1] tracking-[-0.04em] max-w-xl italic">
                    Uczciwa waga, szybki transport i opał, który nie zawodzi. Od lat budujemy zaufanie w Łaziskach.
                </p>

            </div>

            <div class="relative group perspective">
                <div class="absolute -inset-10 bg-[#FF8C00]/20 rounded-[5rem] blur-[100px] opacity-0 group-hover:opacity-100 transition-duration-700"></div>
                
                <div class="relative h-[600px] lg:h-[750px] rounded-[3rem] lg:rounded-[4rem] overflow-hidden border-8 border-white shadow-[0_48px_100px_-12px_rgba(0,0,0,0.15)] bg-white/50 backdrop-blur-xl rotate-1 group-hover:rotate-0 transition-all duration-1000 transform-3d group-hover:translate-z-10">
                    <img src="/img/sklad-alberto.webp" loading="eager" class="w-full h-full object-cover scale-110 group-hover:scale-100 transition-transform duration-700" alt="Plac PHU ALBERTO" />
                    <div class="absolute top-6 left-6 w-12 h-12 border-t-2 border-l-2 border-black/10 rounded-tl-xl"></div>
                    <div class="absolute bottom-6 right-6 w-12 h-12 border-b-2 border-r-2 border-black/10 rounded-br-xl"></div>
                </div>
            </div>
        </header>

        <section id="oferta" class="py-32 border-t border-black/[0.03]">

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-10 gap-6 lg:gap-4">
                <div class="lg:col-span-4 group relative flex flex-col bg-white rounded-[3.5rem] p-6 border border-black/5 hover:border-[#FF8C00]/30 hover:shadow-3xl transition-all duration-700">
                    <div class="p-8 space-y-4">
                        <h3 class="text-5xl font-heavy italic text-black uppercase tracking-tighter">WĘGIEL</h3>
                        <p class="text-gray-600 text-sm leading-relaxed max-w-xs font-medium">Najlepszy węgiel w okolicy. Wysoka kaloryczność, zero problemów z piecem.</p>
                        <a href="/wegiel" class="inline-flex items-center gap-3 text-[10px] font-black uppercase tracking-widest text-[#FF8C00] group-hover:gap-5 transition-all">Zobacz ofertę <span>→</span></a>
                    </div>
                    <div class="mt-auto h-72 rounded-[3rem] overflow-hidden border border-black/5">
                        <img src="/img/wegiel.webp" loading="lazy" class="w-full h-full object-cover grayscale opacity-80 group-hover:grayscale-0 group-hover:opacity-100 group-hover:scale-105 transition-all duration-1000" alt="Węgiel Orzech" />
                    </div>
                </div>

                <div class="lg:col-span-3 group relative flex flex-col bg-white rounded-[3.5rem] p-6 border border-black/5 hover:border-[#FF8C00]/30 hover:shadow-3xl transition-all duration-700">
                    <div class="p-8 space-y-4">
                        <h3 class="text-4xl font-heavy italic text-black uppercase tracking-tighter">PELLET</h3>
                        <p class="text-gray-600 text-sm leading-relaxed font-medium">Czysty, certyfikowany pellet A1. Wydajność, którą poczujesz w portfelu.</p>
                        <a href="/pellet" class="inline-flex items-center gap-3 text-[10px] font-black uppercase tracking-widest text-[#FF8C00] group-hover:gap-5 transition-all">Zobacz ofertę <span>→</span></a>
                    </div>
                    <div class="mt-auto h-72 rounded-[3rem] overflow-hidden border border-black/5">
                        <img src="/img/pellet.webp" loading="lazy" class="w-full h-full object-cover grayscale opacity-80 group-hover:grayscale-0 group-hover:opacity-100 group-hover:scale-105 transition-all duration-1000" alt="Pellet drzewny A1" />
                    </div>
                </div>

                <div class="lg:col-span-3 group relative flex flex-col bg-white rounded-[3.5rem] p-6 border border-black/5 hover:border-[#FF8C00]/30 hover:shadow-3xl transition-all duration-700">
                    <div class="p-8 space-y-4">
                        <h3 class="text-4xl font-heavy italic text-black uppercase tracking-tighter">DREWNO</h3>
                        <p class="text-gray-600 text-sm leading-relaxed font-medium">Sezonowane drewno kominkowe i opałowe. Buk, dąb, brzoza.</p>
                        <a href="/drewno" class="inline-flex items-center gap-3 text-[10px] font-black uppercase tracking-widest text-[#FF8C00] group-hover:gap-5 transition-all">Zobacz ofertę <span>→</span></a>
                    </div>
                    <div class="mt-auto h-72 rounded-[3rem] overflow-hidden border border-black/5">
                        <img src="/img/drewno.webp" loading="lazy" class="w-full h-full object-cover grayscale opacity-80 group-hover:grayscale-0 group-hover:opacity-100 group-hover:scale-105 transition-all duration-1000" alt="Drewno opałowe" />
                    </div>
                </div>
            </div>
        </section>

        <section id="inne" class="py-24 grid md:grid-cols-2 gap-10 lg:gap-16 items-start">
            <div class="group relative bg-black rounded-[4.5rem] p-16 overflow-hidden min-h-[550px] flex flex-col justify-between shadow-2xl shadow-black/10 hover:shadow-[#FF8C00]/10 transition-shadow duration-700">
                <div class="absolute -top-12 -right-12 w-64 h-64 bg-[#FF8C00] blur-[150px] opacity-10 group-hover:opacity-30 transition-opacity"></div>
                <div class="space-y-6 relative z-10">
                    <h3 class="text-6xl font-heavy italic leading-none text-white tracking-tighter uppercase">SKUP <br/><span class="text-[#FF8C00]">ZŁOMU</span></h3>
                    <p class="text-gray-400 text-xl font-medium max-w-sm">Płacimy gotówką od ręki. Miedź, mosiądz, aluminium i stal. Uczciwa klasyfikacja.</p>
                </div>
                <div class="h-44 rounded-[3rem] overflow-hidden border border-white/10 relative z-10">
                    <img src="/img/zlom.webp" loading="lazy" class="w-full h-full object-cover grayscale opacity-60 group-hover:grayscale-0 group-hover:opacity-100 transition-all duration-1000" alt="Skup złomu Łaziska" />
                </div>
                <a href="/zlom" class="relative z-10 w-full text-center py-6 bg-white text-black text-[11px] font-black uppercase tracking-widest rounded-2xl hover:bg-[#FF8C00] hover:text-white transition-all shadow-xl active:scale-95">Pełny cennik skupu</a>
            </div>

            <div class="group relative bg-white rounded-[4.5rem] p-16 overflow-hidden min-h-[550px] flex flex-col justify-between border border-black/5 hover:border-gray-100 shadow-2xl shadow-black/5 hover:shadow-black/10 transition-all duration-700">
                <div class="space-y-6 relative z-10 text-black">
                    <h3 class="text-6xl font-heavy italic leading-none tracking-tighter uppercase">Kruszywa</h3>
                    <p class="text-gray-500 text-xl font-medium max-w-sm">Piasek, żwir i ziemia ogrodowa. Transport HDS bezpośrednio do klienta.</p>
                </div>
                <div class="h-44 rounded-[3rem] overflow-hidden border border-black/5 relative z-10">
                    <img src="/img/kruszywa.webp" loading="lazy" class="w-full h-full object-cover opacity-80 group-hover:opacity-100 group-hover:scale-105 transition-all duration-1000" alt="Kruszywa budowlane" />
                </div>
                <a href="/kruszywa" class="relative z-10 w-full text-center py-6 bg-black text-white text-[11px] font-black uppercase tracking-widest rounded-2xl hover:bg-[#FF8C00] transition-all shadow-xl active:scale-95">Zobacz pełną ofertę</a>
            </div>
        </section>
    </main>
</Layout>

<style>
    /* 2026 Cinematic Reveal Animations */
    .reveal-text {
        animation: revealText 1.5s cubic-bezier(0.19, 1, 0.22, 1) forwards;
    }
    @keyframes revealText {
        0% { opacity: 0; transform: translateY(60px) scale(1.05); }
        100% { opacity: 1; transform: translateY(0) scale(1); }
    }

    /* 2026 Industrial Grayscale Hover Effect */
    @media (min-width: 1024px) {
        .group img.grayscale {
            filter: grayscale(100%);
            opacity: 0.6;
            transition: all 1s ease-out;
        }
        .group:hover img.grayscale {
            filter: grayscale(0%);
            opacity: 1;
            transform: scale(1.05);
        }
    }
</style>