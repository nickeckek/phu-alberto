---
import Layout from '../layouts/Layout.astro';
const runtime = Astro.locals.runtime;
let prices = { wegiel: "0" };
try {
  const data = await runtime?.env?.PRICES_KV.get('current_prices');
  if (data) prices = JSON.parse(data);
} catch (e) {}
---

<Layout title="Ekogroszek Premium | ALBERTO">
    <section class="pt-32 pb-20 px-6 max-w-6xl mx-auto">
        <div class="grid md:grid-cols-2 gap-20 items-center">
            <div data-aos="fade-right">
                <h2 class="text-5xl md:text-8xl font-black italic leading-none mb-6">EKOGROSZEK<br/><span class="text-[#FF8C00]">PREMIUM</span></h2>
                <p class="text-gray-400 leading-relaxed mb-8">Nasz towar jest przesiewany i składowany pod wiatą. Masz gwarancję, że kupujesz suchy węgiel, który nie zatyka podajnika.</p>
                <div class="text-4xl font-black text-white italic tracking-tighter">{prices.wegiel} zł / tona</div>
            </div>

            <div class="bg-white/[0.02] border border-white/10 rounded-[3rem] p-10" data-aos="fade-left">
                <div class="space-y-6">
                    <div class="flex justify-between border-b border-white/5 pb-4">
                        <span class="text-[10px] uppercase text-gray-500 font-bold tracking-widest italic">Wartość opałowa</span>
                        <span class="font-bold text-[#FF8C00]">26-28 MJ/kg</span>
                    </div>
                    <div class="flex justify-between border-b border-white/5 pb-4">
                        <span class="text-[10px] uppercase text-gray-500 font-bold tracking-widest italic">Zawartość popiołu</span>
                        <span class="font-bold">max 6%</span>
                    </div>
                    <div class="flex justify-between border-b border-white/5 pb-4">
                        <span class="text-[10px] uppercase text-gray-500 font-bold tracking-widest italic">Zawartość siarki</span>
                        <span class="font-bold">max 0.6%</span>
                    </div>
                    <div class="flex justify-between">
                        <span class="text-[10px] uppercase text-gray-500 font-bold tracking-widest italic">Granulacja</span>
                        <span class="font-bold">5 - 25 mm</span>
                    </div>
                </div>
            </div>
        </div>
    </section>
</Layout>
<script>
	import AOS from 'aos';
	AOS.init({ duration: 1000, once: true });
</script>