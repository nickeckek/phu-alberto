---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Kontakt | ALBERTO">
    <section class="pt-32 pb-20 px-6 max-w-7xl mx-auto">
        <div class="grid md:grid-cols-2 gap-20">
            <div data-aos="fade-right">
                <h2 class="text-7xl font-black italic mb-10 tracking-tighter">KONTAKT</h2>
                <div class="space-y-10">
                    <div>
                        <p class="text-[#FF8C00] font-bold uppercase text-[10px] tracking-widest italic">Adres Składu</p>
                        <p class="text-3xl font-black mt-2">Łaziska 62<br/>43-170 Łaziska</p>
                    </div>
                    <div>
                        <p class="text-[#FF8C00] font-bold uppercase text-[10px] tracking-widest italic">Zadzwoń</p>
                        <p class="text-3xl font-black mt-2">725 937 718</p>
                    </div>
                    <div>
                        <p class="text-[#FF8C00] font-bold uppercase text-[10px] tracking-widest italic">Godziny Otwarcia</p>
                        <p class="text-xl font-bold mt-2">Pn-Pt: 7:00 - 16:00<br/>Sobota: Zamknięte</p>
                    </div>
                </div>
            </div>
            <div class="bg-white/[0.02] border border-white/10 rounded-[3rem] h-[500px] overflow-hidden grayscale invert opacity-50 transition-all hover:opacity-100 hover:grayscale-0" data-aos="fade-left">
                <iframe 
                    src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2556.5414631313364!2d18.8471!3d50.1341!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0x0!2zNTDCsDA4JzAyLjgiTiAxOMKwNTAnNDkuNiJF!5e0!3m2!1spl!2spl!4v1620000000000!5m2!1spl!2spl" 
                    width="100%" height="100%" style="border:0;" allowfullscreen="" loading="lazy">
                </iframe>
            </div>
        </div>
    </section>
</Layout>
<script>
	import AOS from 'aos';
	AOS.init({ duration: 1000, once: true });
</script>