---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Admin | ALBERTO">
    <div class="min-h-screen bg-[#050505] flex items-center justify-center p-4">
        <div class="w-full max-w-md bg-white/[0.02] border border-white/10 p-10 rounded-[2.5rem] backdrop-blur-3xl shadow-2xl">
            <h1 class="text-3xl font-black text-white italic mb-10 text-center tracking-tighter">SYSTEM <span class="text-[#FF8C00]">ALBERTO</span></h1>
            
            <form id="priceForm" class="space-y-6">
                <div class="space-y-1">
                    <label class="text-[10px] font-bold text-gray-500 uppercase tracking-widest ml-1">Cena Węgla (zł/t)</label>
                    <input type="number" name="wegiel" class="w-full bg-black border border-white/10 rounded-xl p-4 text-[#FFD700] text-2xl font-black outline-none focus:border-[#FF8C00] transition-all" required>
                </div>
                <div class="space-y-1">
                    <label class="text-[10px] font-bold text-gray-500 uppercase tracking-widest ml-1">Cena Pelletu (zł/t)</label>
                    <input type="number" name="pellet" class="w-full bg-black border border-white/10 rounded-xl p-4 text-white text-2xl font-black outline-none focus:border-[#FF8C00] transition-all" required>
                </div>
                <div class="space-y-1">
                    <label class="text-[10px] font-bold text-gray-500 uppercase tracking-widest ml-1">Cena Złomu (zł/kg)</label>
                    <input type="number" step="0.01" name="zlom" class="w-full bg-black border border-white/10 rounded-xl p-4 text-white text-2xl font-black outline-none focus:border-[#FF8C00] transition-all" required>
                </div>
                <div class="pt-6 border-t border-white/10 mt-10">
                    <label class="block text-[10px] font-bold text-red-500 uppercase tracking-widest text-center mb-2 italic">Podaj PIN aby autoryzować</label>
                    <input type="password" id="pin" class="w-full bg-black border border-white/10 rounded-xl p-4 text-center text-white font-black tracking-[1em]" required>
                </div>
                <button type="submit" class="w-full bg-[#FF8C00] text-black font-black py-5 rounded-2xl hover:bg-white transition-all transform active:scale-95 uppercase tracking-widest">Aktualizuj Ceny</button>
            </form>
            <div id="status" class="mt-6 text-center font-bold text-sm uppercase tracking-widest h-6"></div>
        </div>
    </div>
</Layout>

<script>
    const form = document.getElementById('priceForm');
    form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const status = document.getElementById('status');
        const formData = new FormData(e.target);
        const pin = document.getElementById('pin').value;

        const data = {
            wegiel: formData.get('wegiel'),
            pellet: formData.get('pellet'),
            zlom: formData.get('zlom')
        };

        status.innerText = "⏳ PRZETWARZANIE...";
        status.className = "mt-6 text-center font-bold text-sm text-blue-500";

        try {
            const res = await fetch('/api/prices', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'Authorization': pin },
                body: JSON.stringify(data)
            });

            if (res.ok) {
                status.innerText = "✅ CENY ZMIENIONE!";
                status.className = "mt-6 text-center font-bold text-sm text-green-500 uppercase tracking-widest";
                form.reset();
            } else {
                status.innerText = "❌ BŁĄD AUTORYZACJI";
                status.className = "mt-6 text-center font-bold text-sm text-red-500 uppercase tracking-widest";
            }
        } catch (err) {
            status.innerText = "❌ BŁĄD POŁĄCZENIA";
            status.className = "mt-6 text-center font-bold text-sm text-red-500 uppercase tracking-widest";
        }
    });
</script>