---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Panel Admina">
    <div class="min-h-screen pt-32 pb-20 px-6 max-w-6xl mx-auto bg-white">
        <h1 class="font-heavy text-4xl mb-10 text-black italic italic">ZARZĄDZANIE <span class="text-[#FF8C00]">CENAMI</span></h1>
        
        <div class="overflow-x-auto shadow-sm rounded-3xl border border-black/5">
            <table class="w-full text-left bg-white">
                <thead class="bg-gray-50 text-[10px] font-black uppercase tracking-widest text-gray-500">
                    <tr>
                        <th class="p-6">Produkt</th>
                        <th class="p-6">Cena (zł)</th>
                        <th class="p-6">Status</th>
                        <th class="p-6">Krótki opis</th>
                    </tr>
                </thead>
                <tbody id="productTable" class="text-black"></tbody>
            </table>
        </div>

        <div class="mt-12 max-w-md mx-auto nowakowski-card p-10">
            <input type="password" id="pin" class="w-full bg-gray-50 border border-black/5 rounded-2xl p-5 text-center text-2xl font-black tracking-[0.5em] mb-6 outline-none focus:border-[#FF8C00]" placeholder="PIN">
            <button id="saveBtn" class="w-full bg-black text-white font-black py-5 rounded-2xl hover:bg-[#FF8C00] transition-all uppercase tracking-widest text-xs">Zatwierdź zmiany w bazie</button>
            <p id="status" class="mt-6 text-center font-bold text-[10px] uppercase tracking-widest"></p>
        </div>
    </div>
</Layout>

<script>
    const products = [
        { id: 'wegiel_orzech', name: 'Węgiel Orzech' },
        { id: 'wegiel_ekogroszek', name: 'Ekogroszek' },
        { id: 'drewno_opalowe', name: 'Drewno Opałowe' },
        { id: 'pellet_a1', name: 'Pellet Premium' },
        { id: 'zlom_miedz', name: 'Skup Miedzi' },
        { id: 'kruszywo_piasek', name: 'Piasek' }
    ];

    const table = document.getElementById('productTable');
    products.forEach(p => {
        table.innerHTML += `
            <tr class="border-t border-black/5">
                <td class="p-6 font-bold italic uppercase text-sm">${p.name}</td>
                <td class="p-6"><input type="text" data-id="${p.id}" data-field="price" class="border border-black/5 bg-gray-50 p-3 rounded-xl w-24 font-black text-[#FF8C00]"></td>
                <td class="p-6">
                    <select data-id="${p.id}" data-field="status" class="border border-black/5 bg-gray-50 p-3 rounded-xl text-xs font-bold uppercase tracking-tighter">
                        <option value="Dostępny">Dostępny</option>
                        <option value="Brak">Brak</option>
                    </select>
                </td>
                <td class="p-6"><input type="text" data-id="${p.id}" data-field="desc" class="border border-black/5 bg-gray-50 p-3 rounded-xl w-full text-xs" placeholder="..."></td>
            </tr>
        `;
    });

    // Kod zapisu fetch... (identyczny jak w poprzednim poście)
</script>