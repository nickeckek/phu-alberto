---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Panel Admina">
    <div class="min-h-screen pt-32 pb-20 px-6 max-w-6xl mx-auto bg-white text-black">
        <h1 class="font-heavy text-4xl mb-12 italic uppercase tracking-tighter">ZARZĄDZANIE <span class="text-[#FF8C00]">PRODUKTAMI</span></h1>
        <div id="tablesContainer" class="space-y-16"></div>
        <div class="mt-20 max-w-md mx-auto border border-black/5 p-8 rounded-[2.5rem] bg-gray-50/50">
            <p class="text-[10px] font-black uppercase tracking-[0.3em] text-center mb-6 text-gray-400 italic">Autoryzacja zmian</p>
            <input type="password" id="pin" class="w-full bg-white border border-black/5 rounded-2xl p-5 text-center text-2xl font-black tracking-[0.5em] mb-4 outline-none focus:border-[#FF8C00] transition-all" placeholder="PIN">
            <button id="saveBtn" class="w-full bg-black text-white font-black py-5 rounded-2xl hover:bg-[#FF8C00] transition-all uppercase tracking-widest text-xs shadow-xl shadow-black/10">Zatwierdź zmiany w bazie</button>
            <p id="status" class="mt-6 text-center font-bold text-[10px] uppercase tracking-widest min-h-[15px]"></p>
        </div>
    </div>
</Layout>

<script>
    // Konfiguracja kategorii i produktów
    const categories = [
        { 
            name: 'OPAŁ', 
            id: 'opal',
            type: 'sprzedaz', // Statusy: Dostępny / Brak
            items: [
                { id: 'wegiel_orzech', name: 'Węgiel Orzech' },
                { id: 'wegiel_groszek', name: 'Węgiel Groszek' },
                { id: 'wegiel_kostka', name: 'Węgiel Kostka' },
                { id: 'wegiel_brykiet', name: 'Węgiel Brykiet' },
                { id: 'ekogroszek', name: 'Ekogroszek' },
                { id: 'pellet', name: 'Pellet' },
                { id: 'drewno', name: 'Drewno' }
            ]
        },
        { 
            name: 'ZŁOM', 
            id: 'zlom',
            type: 'skup', // Statusy: Skupujemy / Nie skupujemy
            items: [
                { id: 'zlom_miedz', name: 'Miedź' },
                { id: 'zlom_aluminium', name: 'Aluminium' },
                { id: 'zlom_mosiadz', name: 'Mosiądz' },
                { id: 'zlom_stal', name: 'Stal' }
            ]
        },
        { 
            name: 'KRUSZYWA', 
            id: 'kruszywa',
            type: 'sprzedaz',
            items: [
                { id: 'kruszywo_piasek', name: 'Piasek' },
                { id: 'kruszywo_zwir', name: 'Żwir' }
            ]
        }
    ];

    const container = document.getElementById('tablesContainer');
    categories.forEach(cat => {
        const isSkup = cat.type === 'skup';
        const labelCena = isSkup ? 'Cena zakupu' : 'Cena sprzedaży';
        const labelStatus = isSkup ? 'Status skupu' : 'Dostępność';
        const optTak = isSkup ? 'Skupujemy' : 'Dostępny';
        const optNie = isSkup ? 'Nie skupujemy' : 'Brak';
        const section = document.createElement('div');
        section.innerHTML = `
            <div class="mb-6 flex items-center gap-4">
                <div class="h-[2px] w-8 bg-[#FF8C00]"></div>
                <h2 class="font-black italic text-2xl tracking-tighter uppercase">${cat.name}</h2>
            </div>
            <div class="overflow-hidden rounded-3xl border border-black/[0.03] shadow-sm">
                <table class="w-full text-left bg-white border-collapse">
                    <thead class="bg-gray-50/50 text-[9px] font-black uppercase tracking-[0.2em] text-gray-400">
                        <tr>
                            <th class="p-5">Produkt</th>
                            <th class="p-5">${labelCena}</th>
                            <th class="p-5 w-40">${labelStatus}</th>
                            <th class="p-5">Dodatkowe info</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-black/[0.03]">
                        ${cat.items.map(p => `
                            <tr class="hover:bg-gray-50/30 transition-colors">
                                <td class="p-5 font-bold italic text-sm uppercase">${p.name}</td>
                                <td class="p-5">
                                    <input type="text" data-id="${p.id}" data-field="price" class="bg-gray-50/50 border border-black/5 p-3 rounded-xl w-24 font-black text-[#FF8C00] outline-none focus:bg-white focus:border-[#FF8C00] transition-all">
                                </td>
                                <td class="p-5">
                                    <select data-id="${p.id}" data-field="status" class="w-full bg-gray-50/50 border border-black/5 p-3 rounded-xl text-[10px] font-black uppercase outline-none cursor-pointer">
                                        <option value="${optTak}">${optTak}</option>
                                        <option value="${optNie}">${optNie}</option>
                                    </select>
                                </td>
                                <td class="p-5">
                                    <input type="text" data-id="${p.id}" data-field="desc" class="bg-gray-50/50 border border-black/5 p-3 rounded-xl w-full text-xs outline-none focus:bg-white" placeholder="...">
                                </td>
                            </tr>
                        `).join('')}
                    </tbody>
                </table>
            </div>
        `;
        container.appendChild(section);
    });

    // Logika wysyłania do bazy
    document.getElementById('saveBtn').addEventListener('click', async () => {
        const pin = (document.getElementById('pin') as HTMLInputElement).value;
        const status = document.getElementById('status');
        const data = {};

        document.querySelectorAll('[data-id]').forEach(el => {
            const input = el as HTMLInputElement | HTMLSelectElement;
            const id = input.dataset.id;
            const field = input.dataset.field;
            if (!data[id]) data[id] = {};
            data[id][field] = input.value;
        });

        status.innerText = "⏳ ZAPISYWANIE...";
        status.className = "mt-6 text-center font-bold text-[10px] uppercase tracking-widest text-black";

        try {
            const res = await fetch('/api/prices', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'Authorization': pin },
                body: JSON.stringify(data)
            });
            
            if (res.ok) {
                status.innerText = "✅ BAZA ZAKTUALIZOWANA";
                status.className = "mt-6 text-center font-bold text-[10px] uppercase tracking-widest text-green-500";
            } else {
                status.innerText = "❌ BŁĘDNY PIN";
                status.className = "mt-6 text-center font-bold text-[10px] uppercase tracking-widest text-red-500";
            }
        } catch { 
            status.innerText = "❌ BŁĄD SERWERA"; 
            status.className = "mt-6 text-center font-bold text-[10px] uppercase tracking-widest text-red-500";
        }
    });
</script>